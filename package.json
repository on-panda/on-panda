{
  "name": "@on-panda/on-panda",
  "version": "0.6.1",
  "license": "MIT",
  "type": "module",
  "main": "./dist/on-panda.es.js",
  "module": "./dist/on-panda.es.js",
  "exports": {
    ".": {
      "import": "./dist/on-panda.es.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config packages/serve/vite.config.js",
    "build": "vite build",
    "build:web": "vite build --config packages/serve/vite.config.js",
    "build:annotate": "vite build --config apps/annotation-ui/vite.config.js",
    "build:serve": "pnpm build:web",
    "annotate": "pnpm build:annotate && node packages/annotate/bin/annotate.js",
    "build:core": "pnpm --dir packages/on-panda-core build",
    "install:all": "pnpm install && pnpm --dir packages/on-panda-core install && pnpm --dir packages/annotate install && pnpm --dir packages/serve install",
    "build:all": "pnpm build && pnpm build:core && pnpm build:annotate && pnpm build:serve",
    "publish:core": "pnpm --dir packages/on-panda-core build && pnpm publish ./packages/on-panda-core --access public",
    "publish:all": "pnpm install:all && pnpm build:all && pnpm publish --access public && pnpm publish ./packages/on-panda-core --access public && pnpm publish ./packages/annotate --access public && pnpm publish ./packages/serve --access public",
    "install:core": "pnpm --dir packages/on-panda-core install",
    "analyze": "vite build --mode analyze",
    "analyze:web": "vite build --mode analyze --config packages/serve/vite.config.js",
    "analyze:core": "cd packages/on-panda-core && pnpm vite build --mode analyze",
    "preview": "pnpm --dir packages/serve preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.x",
    "@mdit/plugin-katex": "^0.23.2",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "axios": "^1.x",
    "element-plus": "^2.x",
    "highlight.js": "^11.x",
    "json5": "^2.x",
    "katex": "^0.16.x",
    "lz-string": "^1.x",
    "markdown-it": "^14.x",
    "markdown-it-code-copy": "^0.x",
    "openai": "^4.x",
    "pinia": "^2.x",
    "vue": "^3.x",
    "vue-i18n": "^11.x",
    "wavesurfer.js": "^7.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-vue": "^5.0.5",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "postcss": "^8.5.6",
    "postcss-prefix-selector": "^2.1.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "undici": "^7.16.0",
    "vite": "^5.3.1"
  }
}
